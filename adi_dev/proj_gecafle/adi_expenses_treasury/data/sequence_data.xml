<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Séquence automatique des frais.
            noupdate="1" : préfixe/padding éditables par l'utilisateur sans
            écrasement à l'upgrade. use_date_range remet le compteur à 1 par an.
        -->
        <record id="seq_depenses_depense" model="ir.sequence">
            <field name="name">Frais ADI</field>
            <field name="code">depenses.depense</field>
            <field name="prefix">FRAIS/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
