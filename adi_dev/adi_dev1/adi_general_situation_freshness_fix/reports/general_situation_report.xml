<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Étend le rapport PDF de la Situation Générale.
         - Ajoute un en-tête (Code | Nom | Clôturé | En cours | Théorique
           | Dernière clôture) au-dessus du détail des caisses
         - Remplace la ligne de détail par caisse avec une version
           ventilée et colorée selon la fraîcheur
         ================================================================ -->
    <template id="report_general_situation_freshness"
              inherit_id="adi_general_situation.report_general_situation_document">

        <!-- Insère un en-tête juste avant la première ligne caisse. -->
        <xpath expr="//tr[@t-foreach='doc.cash_line_ids']"
               position="before">
            <tr style="border-bottom: 1px solid #aaa; background: #f0f4f8;">
                <th style="padding: 4px 8px; font-size: 10px; font-weight: 600; color: #555; text-align: left; width: 12%;">Code</th>
                <th style="padding: 4px 8px; font-size: 10px; font-weight: 600; color: #555; text-align: left;">Caisse</th>
                <th style="padding: 4px 8px; font-size: 10px; font-weight: 600; color: #555; text-align: right; width: 14%;">Clôturé</th>
                <th style="padding: 4px 8px; font-size: 10px; font-weight: 600; color: #555; text-align: right; width: 14%;">En cours</th>
                <th style="padding: 4px 8px; font-size: 10px; font-weight: 600; color: #555; text-align: right; width: 14%;">Théorique</th>
                <th style="padding: 4px 8px; font-size: 10px; font-weight: 600; color: #555; text-align: right; width: 16%;">Dernière clôture</th>
            </tr>
        </xpath>

        <!-- Remplace la ligne par caisse pour afficher les 6 colonnes
             et colorer le fond selon le champ `freshness`. -->
        <xpath expr="//tr[@t-foreach='doc.cash_line_ids']"
               position="replace">
            <tr t-foreach="doc.cash_line_ids" t-as="cl"
                t-att-style="(
                    'border-bottom: 1px dashed #e6e6e6; '
                    + ('background: #e8f5e9;' if cl.freshness == 'fresh'
                       else 'background: #fff8e1;' if cl.freshness == 'stale'
                       else 'background: #ffebee;' if cl.freshness == 'very_stale'
                       else 'background: #f5f5f5;' if cl.freshness == 'never'
                       else '')
                )">
                <td style="padding: 4px 8px; color: #666;">
                    <span t-esc="cl.code or ''"/>
                </td>
                <td style="padding: 4px 8px; color: #555;">
                    <span t-esc="cl.name"/>
                </td>
                <td style="padding: 4px 8px; text-align: right; color: #198754;">
                    <span t-field="cl.closing_balance"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
                <td t-att-style="'padding: 4px 8px; text-align: right; color: ' + ('#198754' if cl.pending_delta &gt;= 0 else '#dc3545') + ';'">
                    <span t-field="cl.pending_delta"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
                <td style="padding: 4px 8px; text-align: right; color: #212529; font-weight: 600;">
                    <span t-field="cl.balance"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
                <td style="padding: 4px 8px; text-align: right; color: #555; font-size: 11px;">
                    <t t-if="cl.last_closing_date">
                        <span t-field="cl.last_closing_date" t-options="{'widget': 'date'}"/>
                        <span style="color: #888;"> (<t t-esc="cl.days_since_closing"/> j)</span>
                    </t>
                    <t t-else="">
                        <em style="color: #999;">jamais</em>
                    </t>
                </td>
            </tr>
        </xpath>

    </template>

</odoo>
